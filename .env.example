# Template .env — copy jadi .env dan isi nilai asli
# JANGAN commit file .env ke git

# RPC: single atau multiple (pisah koma). Multiple = failover/round-robin otomatis.
# RPC_URLS=https://mainnet.helius-rpc.com/?api-key=KEY1,https://mainnet.helius-rpc.com/?api-key=KEY2,https://rpc.other.com/xxx
RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# Atau single (backward compatible):
# RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

# Private key wallet — support 3 format:
#   1. base58   (string ~88 char)
#   2. array    ([120, 88, 11, ...] 64 angka uint8)
#   3. hex      (128 char hex)
WALLET_PRIVATE_KEY=isi_dengan_private_key_kamu

JITO_API_KEY=
JITO_REGION=frankfurt

MIN_PROFIT_PCT=1.0
USE_JITO=true

# --- FEE OPTIMIZATION ---
# Priority fee = 0 (kecepatan di-handle Jito tip, bukan priority fee)
# Jito tip kecil tapi cukup buat land cepat (default 5000 lamport = 0.000005 SOL)
JITO_TIP_LAMPORTS=5000
