# ============================================================
# SOLANA ARB SCANNER — .env.example
# Copy jadi .env:  cp .env.example .env
# Edit nilai di bawah (jangan commit .env ke GitHub!)
# ============================================================

# --- RPC (bisa beberapa, pisah koma untuk failover) ---
RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY_1,https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY_2,https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY_3

# --- Wallet private key (base58 / array JSON / hex semua didukung) ---
# Ganti dengan PK wallet lo (yang cuma punya SOL cukup)
WALLET_PRIVATE_KEY=isi_dengan_private_key_lo_disini

# --- Execution ---
USE_JITO=true
JITO_TIP_LAMPORTS=5000

# --- Detection / Sizing ---
MIN_PROFIT_PCT=0.5
# Jumlah SOL per test/exec (lamports). 10000000 = 0.01 SOL (aman buat test)
SOL_AMOUNT_LAMPORTS=10000000

# --- SAFETY: true = cuma simulasi (gak submit). false = execute beneran ---
# Bot TETAP guarded: cuma submit kalau profit > tip + 0.002 SOL
DRY_RUN=true
