# ============================================================
# SOLANA ARB SCANNER — .env.example
# Copy jadi .env:  cp .env.example .env
# Edit nilai di bawah (jangan commit .env ke GitHub!)
# ============================================================

# Multi-RPC (pisah koma). Helius / QuickNode / Triton recommended
RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Private key (base58 / [1,2,3...] / hex 128 char)
WALLET_PRIVATE_KEY=

# Execution
USE_JITO=true
JITO_REGION=frankfurt
JITO_TIP_LAMPORTS=5000

# Detection
MIN_PROFIT_PCT=0.8
SOL_AMOUNT_LAMPORTS=10000000
LOOP_MS=12000

# SAFETY — true = hanya simulate, false = submit beneran
DRY_RUN=true

# Optional: Jupiter API key (kurangi 429 rate limit)
# JUPITER_API_KEY=
